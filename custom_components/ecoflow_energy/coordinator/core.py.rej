--- custom_components/ecoflow_energy/coordinator/core.py
+++ custom_components/ecoflow_energy/coordinator/core.py
@@ -237,6 +237,23 @@ class EcoFlowDeviceCoordinator(
         # Whether a Stream ever reported the system state of charge; once it
         # has, a unit's own figure no longer stands in for it (#323).
         self._soc_from_system = False
+
+        # SoC zero-drop guard: a report of 0% arriving right after the feed
+        # goes stale/degraded (rather than a real gradual discharge down to
+        # empty) is held back rather than published, so a dashboard does not
+        # show the battery instantly falling from e.g. 62% to 0% and back.
+        # Keyed per soc field so soc_pct and soc_precise_pct are held
+        # independently. A max hold time bounds this: a battery that
+        # genuinely is empty must eventually be shown as empty rather than
+        # frozen at its last reading forever.
+        #
+        # The last known good reading is cached explicitly here rather than
+        # read back out of `_device_data` at guard time: this cache is
+        # written and read only by the guard itself, so nothing else in the
+        # coordinator can invalidate it from underneath.
+        self._soc_last_good: dict[str, float] = {}  # key -> last real reading
+        self._soc_zero_hold: dict[str, float] = {}  # key -> monotonic ts first held
+
         # Debounce state for the PowerOcean SoC SET. HA Number-Entity sliders
         # send one SET per 5%-step during a mouse drag, which arrives at the
         # device at ~100 ms cadence. The device cannot keep all SETs in sync
